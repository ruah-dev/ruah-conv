{
	"name": "@ruah-dev/conv-core",
	"version": "0.4.0",
	"description": "Core implementation for converting API specs (OpenAPI) into agent-ready tool surfaces.",
	"type": "module",
	"ruah": {
		"namespace": "conv",
		"description": "Convert API specs to agent-ready tool surfaces"
	},
	"files": [
		"dist/",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsc && chmod +x dist/cli.js",
		"dev": "tsc --watch",
		"prepare": "npm run build",
		"start": "node dist/cli.js",
		"pretest": "tsc -p tsconfig.test.json",
		"test": "node --test dist-test/test/*.test.js",
		"lint": "biome check . --config-path ./biome.core.json",
		"format": "biome check --write . --config-path ./biome.core.json",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist dist-test",
		"prepublishOnly": "npm run clean && npm run build && npm test"
	},
	"keywords": [
		"ai",
		"agents",
		"mcp",
		"openapi",
		"convert",
		"function-calling",
		"tool-surface",
		"claude",
		"ruah"
	],
	"author": "ruah-dev",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ruah-dev/ruah-conv.git"
	},
	"bugs": {
		"url": "https://github.com/ruah-dev/ruah-conv/issues"
	},
	"homepage": "https://github.com/ruah-dev/ruah-conv#readme",
	"engines": {
		"node": ">=18.0.0"
	},
	"dependencies": {
		"yaml": "^2.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@types/node": "^25.5.2",
		"typescript": "^6.0.2"
	}
}
