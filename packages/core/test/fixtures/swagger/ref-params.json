{
	"swagger": "2.0",
	"info": {
		"title": "Swagger Ref Params",
		"version": "1.0.0"
	},
	"host": "api.example.com",
	"basePath": "/v1",
	"schemes": ["https"],
	"parameters": {
		"LimitParam": {
			"name": "limit",
			"in": "query",
			"type": "integer",
			"description": "Max items to return."
		},
		"OffsetParam": {
			"name": "offset",
			"in": "query",
			"type": "integer",
			"description": "Items to skip."
		}
	},
	"paths": {
		"/things": {
			"get": {
				"operationId": "listThings",
				"summary": "List things",
				"parameters": [
					{ "$ref": "#/parameters/LimitParam" },
					{ "$ref": "#/parameters/OffsetParam" }
				],
				"responses": {
					"200": { "description": "OK" }
				}
			}
		}
	}
}
