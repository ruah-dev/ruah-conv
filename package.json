{
	"name": "@ruah-dev/conv",
	"version": "0.2.0",
	"description": "Standalone package for converting API specs into agent-ready tool surfaces.",
	"type": "module",
	"bin": {
		"ruah-conv": "./bin/ruah-conv.js"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		}
	},
	"files": [
		"bin/",
		"index.d.ts",
		"index.js",
		"postinstall.mjs",
		"test/",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "npm run build --prefix packages/core",
		"postinstall": "node postinstall.mjs",
		"test": "node --test test/*.test.mjs && npm run test --prefix packages/core",
		"typecheck": "npm run typecheck --prefix packages/core",
		"lint": "biome check . --config-path ./biome.json && npm run lint --prefix packages/core",
		"format": "biome check --write . --config-path ./biome.json",
		"prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
	},
	"keywords": [
		"ai",
		"agents",
		"mcp",
		"openapi",
		"convert",
		"function-calling",
		"tool-surface",
		"claude",
		"ruah"
	],
	"author": "ruah-dev",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ruah-dev/ruah-conv.git"
	},
	"bugs": {
		"url": "https://github.com/ruah-dev/ruah-conv/issues"
	},
	"homepage": "https://github.com/ruah-dev/ruah-conv#readme",
	"engines": {
		"node": ">=18.0.0"
	},
	"dependencies": {
		"@ruah-dev/conv-core": "file:./packages/core"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10"
	}
}
